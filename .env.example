# Application
APP_ENV=development
LOG_LEVEL=INFO

# SEC / Data Source
SEC_USER_AGENT=
SEC_COMPANY=
SEC_REQUEST_TIMEOUT=30

# LLM
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=

#Embeddings
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=


#Sparse Retrieval
SPARSE_RETRIEVER=bm25

#Vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fintrace_chunks

#retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_K=20
RERANK_TOP_K=5

#Reranker
RERANKER_PROVIDER=
RERANKER_MODEL=

#Generator
GENERATION_MAX_CONTEXT_TOKENS=
CITATIONS_ENABLED=true

#Verification
VERIFIER_PROVIDER=
VERIFIER_MODEL=
VERIFIER_API_KEY=

# Observability
PHOENIX_ENDPOINT=
OTEL_SERVICE_NAME=fintrace
OTEL_EXPORTER_OTLP_ENDPOINT=

# Runtime
REQUEST_TIMEOUT=30
MAX_RETRIES=3